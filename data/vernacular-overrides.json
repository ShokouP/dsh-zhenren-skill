  "黽": "蛙黾。",
  "黿": "大鳖。",
  "鼄": "蜘蛛。",
  "鼉": "水虫：似蜥蜴，长大。",
  "鼎": "三足两耳，和五味之宝器。",
  "鼓": "击鼓。",
  "鼠": "穴虫总名。",
  "鼻": "引气自畀。",
  "齊": "禾麦吐穗上平。",
  "齒": "口齗骨。",
  "龍": "鳞虫之长。",
  "龏": "悫。",
  "龐": "高屋。",
  "龓": "兼有。",
  "龔": "给。",
  "龖": "飞龙。",
  "龜": "旧：外骨内肉者。",
  "龠": "乐之竹管，三孔，以和众声。",
  "龢": "调；「和」的本字。",
  "𠧞": "灼龟坼；「兆」的本字。",
  "𠬞": "竦手；「廾」的本字。",
  "𢍜": "酒器；「尊」的本字。",
  "𢒫": "绎理；「寻」的本字。",
  "𣻣": "徒行厉水；「涉」的本字。",
  "𤓪": "火所伤；「焦」的本字。",
  "𤘐": "齿蠹；「龋」的本字。",
  "𥛱": "门内祭先祖。",
  "𥝩": "禾成秀；「穗」的本字。",
  "𦙪": "髆；肩膊。",
  "𧎮": "啮人跳虫；蚤。",
  "𨒌": "正、行；「征」的本字。",
  "𨸏": "大陆：山无石者；「阜」的本字。",
  "𩙺": "翅。",
  "𩫚": "豕：鬣如笔管，出南郡；「豪」的本字。",
  "𩱫": "鼎实；惟苇及蒲。",
  "𩼪": "捕鱼；「渔」的本字。",
  "𪉷": "长味；「覃」的本字。"
}
